#!/bin/sh
# Installs zig 0.16.0 for this host, by its digest, and prints the directory that holds it, for
# PATH: the C compiler scripts/zig-cc gives aws-lc-sys's C for each target scripts/gates.sh lints
# other than the host's (Shards' pin, its scripts/zig-pin). Digests from
# https://ziglang.org/download/index.json. CI's job keeps it in its runner's temporary directory;
# elsewhere it is the user's cache.
set -eu
version=0.16.0
case "$(uname -s)-$(uname -m)" in
	Linux-x86_64) host=x86_64-linux; sum=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00 ;;
	Linux-aarch64) host=aarch64-linux; sum=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17 ;;
	Darwin-arm64) host=aarch64-macos; sum=b23d70deaa879b5c2d486ed3316f7eaa53e84acf6fc9cc747de152450d401489 ;;
	*) echo "install-zig: no pinned zig for $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac
home="${RUNNER_TEMP:-${XDG_CACHE_HOME:-$HOME/.cache}/reliquary/zig}"
dir="$home/zig-$host-$version"
if [ ! -x "$dir/zig" ]; then
	mkdir -p "$home"
	archive="$home/zig-$host-$version.tar.xz"
	curl -fsSL --retry 5 --retry-all-errors --retry-delay 10 -o "$archive" "https://ziglang.org/download/$version/zig-$host-$version.tar.xz"
	# The check's own words go to stderr: stdout is the directory alone.
	if command -v sha256sum >/dev/null 2>&1; then
		echo "$sum  $archive" | sha256sum -c - >&2
	else
		echo "$sum  $archive" | shasum -a 256 -c - >&2
	fi
	tar -xJf "$archive" -C "$home"
	rm -f -- "${archive:?}"
fi
echo "$dir"
